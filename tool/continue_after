#!/bin/bash

# continue_after: A wrapper to notify on command completion.
# Usage: continue_after <command> [args...]

if [ $# -eq 0 ]; then
    echo "Usage: continue_after <command> [args...]"
    exit 1
fi

# Store the command string for the notification
COMMAND_STR="$*"

# Execute the command
"$@"
EXIT_CODE=$?

# Determine the status and emoji
if [ $EXIT_CODE -eq 0 ]; then
    STATUS="✅ Case Closed"
else
    STATUS="❌ Case Dismissed (Exit $EXIT_CODE)"
fi

# Use the notifyme tool from the same directory if available, 
# otherwise rely on the PATH.
TOOL_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$TOOL_DIR/notifyme" ]; then
    NOTIFYME_CMD="$TOOL_DIR/notifyme"
elif [ -x "$TOOL_DIR/notifyme.py" ]; then
    NOTIFYME_CMD="$TOOL_DIR/notifyme.py"
else
    NOTIFYME_CMD="notifyme"
fi

# Send the notification
# notifyme.py will check for LIMILINK_SESSION environment variable.
$NOTIFYME_CMD "[$STATUS] continue_after $COMMAND_STR"

# Exit with the original command's exit code
exit $EXIT_CODE
