(agent_by_alias ()
 (gemini-cli
  (harness gemini-cli)
  (model auto)
  (readonly_mode_on true)
  (session_symlink_dict ()
   (agent_specific_link.txt ./agent_specific_target.txt)
  )
 )
)
(gemini_exepath gemini)
(gemini_system_md gemini_cli/SYSTEM.md)
(gemini_workspace_md gemini_cli/GEMINI.md)
(session_symlink_dict ()
 (test_target.txt ./test_target.txt)
 (dreamscape ~/dreamscape)
 (SOUL.md ~/dreamscape/paprika_cwd/SOUL.md)
 (IDENTITY.md ~/dreamscape/paprika_cwd/IDENTITY.md)
 (USER.md ~/dreamscape/paprika_cwd/USER.md)
 (MEMORY.md ~/dreamscape/paprika_cwd/MEMORY.md)
 (bin ~/dreamscape/scripts)
 (memory ~/dreamscape/paprika_cwd/memory)
 (skills ~/dreamscape/skills)
)
(session_dirpath ../session)
(port 11011)
